{
  "name": "okc-wholesale-ai-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run infra:preflight",
    "build": "node scripts/build-with-lock.mjs",
    "start": "next start",
    "test": "node --import tsx --test lib/company-orchestrator.test.ts lib/company-activation.test.ts lib/company-draft-workspace.test.ts lib/public-lead-intake.test.ts lib/approved-execution-layer.test.ts lib/operating-loop-trace.test.ts lib/department-artifact-engine.test.ts lib/connector-health-contract.test.ts lib/connector-activation-report.test.ts lib/dfd-operating-conductor.test.ts lib/production-dry-run.test.ts lib/preview-live-dry-run-test.test.ts lib/preview-database-fingerprint-diagnosis.test.ts lib/adobe-creative-cloud-governance.test.ts lib/env.test.ts lib/infrastructure-health.test.ts lib/department-intelligence.test.ts lib/marketing-platform-registry.test.ts lib/content-intelligence.test.ts lib/core-platform-registry.test.ts lib/executive-dashboard.test.ts lib/dashboard-navigation.test.ts lib/read-only-business-connections.test.ts lib/daily-mission.test.ts lib/security-log.test.ts lib/request-security.test.ts lib/security-headers.test.ts lib/twilio-webhook-security.test.ts",
    "infra:preflight": "node --import tsx scripts/infrastructure-preflight.ts",
    "infra:runtime-preflight": "node --import tsx scripts/infrastructure-runtime-preflight.ts",
    "diagnose": "node --import tsx scripts/diagnose.ts all",
    "diagnose:infra": "node --import tsx scripts/diagnose.ts infra",
    "diagnose:connectors": "node --import tsx scripts/diagnose.ts connectors",
    "adobe:readiness": "node --import tsx scripts/adobe-governance-readiness.ts",
    "adobe:preview-credential-probe": "node --import tsx scripts/adobe-preview-credential-probe.ts",
    "preview:db-fingerprint-diagnose": "node --import tsx scripts/preview-database-fingerprint-diagnosis.ts",
    "preview:live-dry-run": "node --import tsx scripts/preview-live-dry-run-test.ts",
    "accessibility:certify": "node --import tsx scripts/accessibility-certification.ts",
    "test:e2e:accessibility": "playwright test tests/e2e/accessibility-certification.spec.ts tests/e2e/accessibility-toolbar.spec.ts",
    "verify:predeploy": "npm run infra:runtime-preflight",
    "lint": "eslint app components lib scripts tests --ext .ts,.tsx --max-warnings=0",
    "test:unit:all": "node --import tsx scripts/run-all-lib-tests.ts",
    "verify:full:isolated": "bash scripts/verify-full-isolated.sh",
    "test:activation-smoke": "node --import tsx --test tests/activation/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:linux": "bash scripts/run-playwright-linux.sh",
    "acceptance:executive-autonomy-l1": "set PLAYWRIGHT_PORT=3031&& set PLAYWRIGHT_REUSE_SERVER=false&& playwright test tests/e2e/executive-autonomy-l1-acceptance.spec.ts --project=chromium --workers=1",
    "test:pressure": "playwright test tests/e2e/pressure.spec.ts",
    "test:pressure:professional-cases": "node --import tsx scripts/professional-case-pressure.ts",
    "test:pressure:professional-cases:isolated": "bash scripts/run-professional-case-pressure-isolated.sh",
    "test:safety": "node --import tsx --test tests/safety/*.test.ts tests/safety/*.test.mjs",
    "test:migrations": "node --import tsx --test tests/migrations/*.test.ts",
    "test:repo-integrity": "bash scripts/check-repository-integrity.sh",
    "test:classification": "node --import tsx scripts/validate-test-classification.ts",
    "postinstall": "node scripts/prisma-generate-if-missing.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@prisma/client": "^6.15.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.542.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.3.1",
    "twilio": "^6.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "^9.34.0",
    "eslint-config-next": "16.3.0",
    "lighthouse": "^13.4.1",
    "prisma": "^6.15.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.22.4",
    "typescript": "^5.9.2",
    "vitest": "3.2.6"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "js-yaml": "4.3.1",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    }
  }
}
