    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.34.0",
    "eslint-config-next": "^16.2.3",
    "prisma": "^6.15.0",
    "storybook": "^10.5.0",
    "tailwindcss": "^4.1.13",
