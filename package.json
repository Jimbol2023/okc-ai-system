  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run infra:preflight",
    "build": "next build",
    "start": "next start",
    "test": "node --import tsx --test lib/company-orchestrator.test.ts lib/company-activation.test.ts lib/company-draft-workspace.test.ts lib/approved-execution-layer.test.ts lib/operating-loop-trace.test.ts lib/department-artifact-engine.test.ts lib/connector-health-contract.test.ts lib/connector-activation-report.test.ts lib/dfd-operating-conductor.test.ts lib/production-dry-run.test.ts lib/env.test.ts lib/infrastructure-health.test.ts lib/department-intelligence.test.ts lib/marketing-platform-registry.test.ts lib/content-intelligence.test.ts lib/core-platform-registry.test.ts lib/executive-dashboard.test.ts lib/dashboard-navigation.test.ts lib/read-only-business-connections.test.ts lib/daily-mission.test.ts",
    "infra:preflight": "node --import tsx scripts/infrastructure-preflight.ts",
    "diagnose": "node --import tsx scripts/diagnose.ts all",
    "diagnose:infra": "node --import tsx scripts/diagnose.ts infra",
    "diagnose:connectors": "node --import tsx scripts/diagnose.ts connectors",
    "verify:predeploy": "node --import tsx scripts/diagnose.ts predeploy",
