  sourceLabel          String
  reasonCodes          Json
  safeMetadata         Json
  providerCalled       Boolean  @default(false)
  sent                 Boolean  @default(false)
  published            Boolean  @default(false)
  liveExecutionAllowed Boolean  @default(false)
  createdAt            DateTime @default(now())

  @@index([tenantId])
  @@index([eventType])
  @@index([entityType])
  @@index([entityId])
  @@index([leadId])
  @@index([propertyAddress])
  @@index([campaignId])
  @@index([userId])
  @@index([aiAgent])
  @@index([connectorId])
  @@index([status])
  @@index([sourceLabel])
  @@index([providerCalled])
  @@index([sent])
  @@index([published])
  @@index([liveExecutionAllowed])
  @@index([createdAt])
}

model ManualLeadIntake {
  id                 String   @id @default(uuid())
  leadId             String?
  source             String
  sourceLabel        String
  sellerName         String
  phone              String?
  email              String?
  socialHandle       String?
  propertyAddress    String?
  city               String?
  state              String?
  zipCode            String?
  notes              String
  captureContext     String
  intakeStatus       String   @default("pending_review")
  manualReviewStatus String   @default("needs_manual_review")
  safetyFlags        Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([source])
  @@index([sourceLabel])
  @@index([intakeStatus])
  @@index([manualReviewStatus])
  @@index([createdAt])
}

model SellerCallOutcome {
  id                      String   @id @default(uuid())
  leadId                  String
  outcome                 String
  callCompletedAt         DateTime
  operatorSummary         String
  sellerMotivationSignal  String
  sellerTimelineSignal    String
  propertyConditionSignal String
  priceExpectationSignal  String
  manualNextStep          String
  safetyFlags             Json
  createdAt               DateTime @default(now())

  @@index([leadId])
  @@index([outcome])
  @@index([callCompletedAt])
  @@index([createdAt])
}

model AiPerformanceMetric {
  id   String   @id @default(uuid())
  date DateTime @unique

  totalLeads         Int @default(0)
  newLeads           Int @default(0)
  contactedLeads     Int @default(0)
  negotiatingLeads   Int @default(0)
  underContractLeads Int @default(0)
  closedLeads        Int @default(0)

  sellerReplies     Int   @default(0)
  aiClassifications Int   @default(0)
  avgConfidence     Float @default(0)

  humanApprovalsNeeded Int @default(0)
  suggestedReplies     Int @default(0)
  dncCount             Int @default(0)
  hotLeads             Int @default(0)

  automationScheduled Int @default(0)
  automationIdle      Int @default(0)

  staleNewLeads    Int @default(0)
  overdueFollowUps Int @default(0)

  systemWarnings Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([createdAt])
}

model AiJob {
  id           String    @id @default(uuid())
  status       String    @default("started")
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  errorMessage String?

  actions AiJobAction[]
  logs    AiJobLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([startedAt])
  @@index([completedAt])
}

model AiJobAction {
  id        String   @id @default(uuid())
  jobId     String
  action    String
  count     Int      @default(0)
  createdAt DateTime @default(now())

  job AiJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([action])
}

model AiJobLog {
  id        String   @id @default(uuid())
  jobId     String
  level     String   @default("info")
  message   String
  createdAt DateTime @default(now())

  job AiJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([createdAt])
}

model AiMemoryEvent {
  id               String   @id @default(uuid())
  leadId           String?
  jobId            String?
  actionId         String?
  eventType        String
  source           String
  sellerReply      String?
  aiSuggestedReply String?
  humanFinalReply  String?
  approvalDecision String?
  messageChannel   String?
  messageStatus    String?
  sellerIntent     String?
  sellerSentiment  String?
  confidence       Float?
  outcome          String?
  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([leadId])
  @@index([jobId])
  @@index([actionId])
  @@index([eventType])
  @@index([source])
  @@index([createdAt])
}

model AiLearningRecommendation {
  id                 String    @id @default(uuid())
  type               String
  title              String
  description        String
  recommendationData Json?
  applicationPlan    Json?
  confidence         Float     @default(0)
  status             String    @default("pending")
  createdAt          DateTime  @default(now())
  reviewedAt         DateTime?
  appliedAt          DateTime?
  autoPromotable     Boolean   @default(false)
  promotedAt         DateTime?

  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([promotedAt])
}

enum BuyerActivityEventType {
  deal_sent
  deal_viewed
  deal_opened
  link_clicked
  responded
  replied
  requested_details
  offer_made
  deal_closed
  deal_passed
  unsubscribed_or_inactive
}

enum BuyerTier {
  A
  B
  C
  D
}

model Buyer {
  id                       String    @id @default(uuid())
  name                     String
  phone                    String?
  email                    String?
  preferredLocations       Json?
  priceRangeMin            Int?
  priceRangeMax            Int?
  propertyTypes            Json?
  financingType            String?
  tier                     BuyerTier @default(D)
  preferredDealSize        Int?
  preferredCondition       String?
  source                   String?
  tags                     Json?
  buyerQualityScore        Int       @default(0)
  lastActiveAt             DateTime?
  activityCount            Int       @default(0)
  meaningfulActivityCount  Int       @default(0)
  lastMeaningfulActivityAt DateTime?
  isActive                 Boolean   @default(false)
  qualityReasons           Json?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  activities BuyerActivity[]

  @@index([createdAt])
  @@index([phone])
  @@index([email])
  @@index([priceRangeMin, priceRangeMax])
  @@index([financingType])
  @@index([tier])
  @@index([preferredDealSize])
  @@index([source])
  @@index([buyerQualityScore])
  @@index([lastActiveAt])
  @@index([lastMeaningfulActivityAt])
  @@index([isActive])
}

model BuyerActivity {
  id        String                 @id @default(uuid())
  buyerId   String
  dealId    String?
  eventType BuyerActivityEventType
  metadata  Json?
  createdAt DateTime               @default(now())

  buyer Buyer @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([buyerId])
  @@index([dealId])
  @@index([eventType])
  @@index([createdAt])
}

model MarketingDraft {
  id            String   @id @default(uuid())
  channel       String
  topic         String
  sourceLabel   String
  status        String   @default("draft")
  draftCopy     String
  assetNotes    String?
  referralLink  String?
  assumptions   Json?
  safetyFlags   Json?
  createdSource String   @default("template")
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  approvals                  MarketingApproval[]
  publishAssists             MarketingPublishAssist[]
  canvaAssetAssists          MarketingCanvaAssetAssist[]
  marketingSalesAttributions MarketingSalesAttribution[]

  @@index([channel])
  @@index([status])
  @@index([sourceLabel])
  @@index([referralLink])
  @@index([createdAt])
}

model MarketingApproval {
  id         String   @id @default(uuid())
  draftId    String
  decision   String
  editedCopy String?
  note       String
  reviewer   String?
  createdAt  DateTime @default(now())

  draft MarketingDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
  @@index([decision])
  @@index([createdAt])
}

model MarketingAccountConnection {
  id                 String    @id @default(uuid())
  platform           String    @unique
  accountName        String
  handle             String
  profileUrl         String
  verificationStatus String    @default("manual_setup")
  proofNote          String
  lastVerifiedAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([verificationStatus])
  @@index([lastVerifiedAt])
}

model MarketingPublishAssist {
  id                     String    @id @default(uuid())
  draftId                String
  preparedCopy           String
  assetChecklist         Json
  manualPostingChecklist Json
  sourceLabel            String
  status                 String    @default("ready_for_manual_publish")
  manualPublishedUrl     String?
  manualPublishedAt      DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  draft MarketingDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  marketingSalesAttributions MarketingSalesAttribution[]

  @@index([draftId])
  @@index([status])
  @@index([sourceLabel])
  @@index([createdAt])
}

model MarketingCanvaAssetAssist {
  id                   String   @id @default(uuid())
  draftId              String
  recommendedFormat    String
  designBrief          String
  brandSafeCopyBlocks  Json
  assetNotes           String?
  manualApprovalStatus String   @default("pending_manual_asset_approval")
  safetyFlags          Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  draft MarketingDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  marketingSalesAttributions MarketingSalesAttribution[]

  @@index([draftId])
  @@index([recommendedFormat])
  @@index([manualApprovalStatus])
  @@index([createdAt])
}

model MarketingSalesAttribution {
  id                 String   @id @default(uuid())
  leadId             String
  marketingDraftId   String?
  canvaAssetAssistId String?
  publishAssistId    String?
  channel            String
  topic              String
  sourceLabel        String
  manualPostUrl      String?
  attributionStatus  String   @default("manual_review")
  attributionNote    String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  lead             Lead                       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  marketingDraft   MarketingDraft?            @relation(fields: [marketingDraftId], references: [id], onDelete: SetNull)
  canvaAssetAssist MarketingCanvaAssetAssist? @relation(fields: [canvaAssetAssistId], references: [id], onDelete: SetNull)
  publishAssist    MarketingPublishAssist?    @relation(fields: [publishAssistId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([marketingDraftId])
  @@index([canvaAssetAssistId])
  @@index([publishAssistId])
  @@index([channel])
  @@index([sourceLabel])
  @@index([attributionStatus])
  @@index([createdAt])
}

model SalesConversionAssist {
  id                   String   @id @default(uuid())
  leadId               String
  assistType           String   @default("manual_sales_conversion")
  nextSalesAction      String
  callOpener           String
  sellerQuestions      Json
  objectionNotes       Json
  followUpDrafts       Json
  offerReadiness       Json
  roiSignals           Json
  safetyFlags          Json
  manualApprovalStatus String   @default("pending_manual_review")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([assistType])
  @@index([manualApprovalStatus])
  @@index([createdAt])
}

model FinanceEntry {
  id            String   @id @default(uuid())
  entryType     String
  category      String
  source        String
  amountCents   Int
  entryDate     DateTime
  notes         String
  leadId        String?
  dealReference String?
  assumption    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([entryType])
  @@index([category])
  @@index([source])
  @@index([entryDate])
  @@index([leadId])
  @@index([createdAt])
}

model KnowledgeItem {
  id        String   @id @default(uuid())
  title     String
  category  String
  content   String
  tags      Json
  status    String   @default("draft")
  source    String   @default("manual")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([source])
  @@index([createdAt])
}

model KnowledgeSearchEmbedding {
  id          String   @id @default(uuid())
  sourceType  String
  sourceId    String
  contentHash String
  embedding   Json
  model       String
  dimensions  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sourceType, sourceId])
  @@index([sourceType])
  @@index([sourceId])
  @@index([model])
  @@index([createdAt])
}
